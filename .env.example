# Neo4j connection settings for the local graph service.
#
# Copy this file to .env before starting Neo4j or the application.
#
# Local Python:
# app/core/config.py reads these values from .env.
#
# Docker Compose:
# Docker Compose reads NEO4J_USER and NEO4J_PASSWORD from .env to configure
# the neo4j and neo4j-test services.
#
# Inside the api and init containers, NEO4J_URI is set to
# bolt://neo4j:7687 so the containers can reach the Neo4j service.
# The localhost value below is used when running Python directly.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_password

# Optional local SOP synthesis. When enabled, deterministic SOP retrieval
# runs first, then Ollama may rewrite retrieved evidence into a concise
# cited answer. Failed model calls or invalid citations fall back to the
# deterministic answer.
LOCAL_LLM_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=2m
# Internal Ollama transport timeout in seconds, separate from the UI timeout.
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
