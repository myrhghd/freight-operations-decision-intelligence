# Neo4j connection settings for the local graph service.
#
# Used two ways:
# - Locally with Python: read directly by app/core/config.py.
# - With docker compose: NEO4J_USER and NEO4J_PASSWORD are also read from
#   this file by the Compose CLI itself to set the neo4j and neo4j-test
#   containers' credentials. Inside the api and init containers, NEO4J_URI
#   is overridden to bolt://neo4j:7687 (the service name), so the value
#   below only applies to running the app directly with Python.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_password
